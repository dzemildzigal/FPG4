# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Data and results
data/
out/*
*.npz
*.npy

# Plots
*.png
*.pdf

# Vivado
.Xil/
*.jou
*.log
*.str
*.bit
*.dcp
*.rpt
*.vcd
*.wdb

# Editors
.DS_Store
*.swp

# The curve figures are evidence and they are committed, so they are excepted from the two rules
# above and from the plot rule. The negation only works on out/*, not on out/ : git cannot
# re-include a file whose parent directory is excluded. Keep it last, because the last match wins.
!out/curves_*.png
!docs/curves_*.png
